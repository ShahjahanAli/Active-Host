{
  "name": "remoteservermanager-server-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Express-based remote host agent for Remote Server Manager",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.3.1",
    "eslint": "10.0.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
