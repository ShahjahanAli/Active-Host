MONGODB_URI=mongodb://localhost:27017/remoteservermanager
MONGODB_DB=remoteservermanager
AGENT_API_KEY_PEPPER=replace-with-a-long-random-secret
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
DEV_USER_ID=dev-user-1

MCP_SECRET=<openssl rand -hex 32>
MCP_OWNER_ID=<your-clerk-user-id>

# ─── CI / CD ────────────────────────────────────────────────────────────────
# No additional env vars are required for the CI/CD platform.
# Each project stores its own webhookSecret (auto-generated, saved in MongoDB).
# GitHub webhook URL: POST https://<your-domain>/api/webhooks/github
